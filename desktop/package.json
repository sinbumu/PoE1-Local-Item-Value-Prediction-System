{
  "name": "poe1-v2-local-item-value-app",
  "version": "0.1.0",
  "private": true,
  "description": "Electron MVP for PoE1 local item value triage.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:desktop-models": "npm --prefix .. run prepare:desktop-models --",
    "prepare:embedded-python": "powershell -ExecutionPolicy Bypass -File scripts/prepare-embedded-python.ps1",
    "verify:package-prereqs": "node scripts/verify-packaging-prereqs.js",
    "pack:win": "npm --prefix .. run build && npm run verify:package-prereqs && electron-builder --win dir",
    "dist:win": "npm --prefix .. run build && npm run verify:package-prereqs && electron-builder --win nsis"
  },
  "build": {
    "appId": "local.poe1.item-value-triage",
    "productName": "PoE1 Item Value Triage",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*",
      "renderer/**/*",
      "floating/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      },
      {
        "from": "../ml/predict_desktop_item_value.py",
        "to": "ml/predict_desktop_item_value.py"
      },
      {
        "from": "models/v2_mvp",
        "to": "models/v2_mvp"
      },
      {
        "from": "../samples/clipboard/en",
        "to": "samples/clipboard/en"
      },
      {
        "from": "vendor/python-win",
        "to": "python"
      }
    ],
    "win": {
      "icon": "assets/icons/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "assets/icons/app-icon.ico",
      "uninstallerIcon": "assets/icons/app-icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  }
}
